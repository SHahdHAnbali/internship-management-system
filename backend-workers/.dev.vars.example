# Local development settings for `npm run dev` (wrangler dev). Copy to .dev.vars (git-ignored) and fill in.
# These override the `vars` in wrangler.jsonc. Never put real production secrets here.
ENVIRONMENT=development

# Local PostgreSQL from ../compose.yaml (database migrated by the EF Core migrations in ../backend).
DATABASE_URL=postgres://ims:<POSTGRES_PASSWORD from ../.env>@localhost:5434/ims_dev?sslmode=disable

# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=<generate>

GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=stu.najah.edu,progineer.net
TRAINEE_SIGN_IN_LINK_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
EMAIL_PROVIDER=log
